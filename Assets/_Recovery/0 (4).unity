    m_Modifications:
    - target: {fileID: 730941126697930974, guid: 5c74da10001d6b145abc505ecb79699c, type: 3}
      propertyPath: m_text
      value: "\nIt's quite common for VFX artists to rely on <b>sprite sheets</b>.
        This VFX shows how to use <b>UVs options</b> in the <b>Output</b> to use
        a <b>sprite sheet</b>. It also explains how to set up the Flipbook Settings
        and its relationship with the <b>texIndex attribute</b>.\n\n<b>Covered Aspects</b>:\n\u2022
        TexIndex Attribute\n\u2022 UVs Mode\n\u2022 Flipbook"
      objectReference: {fileID: 0}
    - target: {fileID: 843415515038894783, guid: 5c74da10001d6b145abc505ecb79699c, type: 3}
