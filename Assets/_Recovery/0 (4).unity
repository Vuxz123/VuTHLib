    - target: {fileID: 3639503130760246571, guid: 880de12b545a1a2438644f5c247282f7, type: 3}
      propertyPath: m_text
      value: Rotation & Angular Velocity
      objectReference: {fileID: 0}
    - target: {fileID: 3639503130760246571, guid: 880de12b545a1a2438644f5c247282f7, type: 3}
      propertyPath: m_fontSize
      value: 0.25
      objectReference: {fileID: 0}
    - target: {fileID: 6812649016629805472, guid: 880de12b545a1a2438644f5c247282f7, type: 3}
      propertyPath: m_text
      value: "\nThe <b>Particle\u2019s rotation</b> can be controlled by setting
        the <b>angle attribute</b>. To get more realistic behavior, you can also,
        like in this example, use the <b>angular velocity</b>. This attribute is
        usually set in the <b>Initialize Context</b>, and then, the <b>Update Context</b>
        is responsible for <b>integrating</b> this <b>angular velocity</b> to update
        the rotation.\n\n<b>Covered Aspects</b>:\n\u2022 Angular Velocity\n\u2022
        Angle\n\u2022 Update Rotation"
      objectReference: {fileID: 0}
    - target: {fileID: 6853316224602725313, guid: 880de12b545a1a2438644f5c247282f7, type: 3}
      propertyPath: m_text
      value: Rotation & Angular Velocity
      objectReference: {fileID: 0}
    - target: {fileID: 6853316224602725313, guid: 880de12b545a1a2438644f5c247282f7, type: 3}
      propertyPath: m_fontSize
