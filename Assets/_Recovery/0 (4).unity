    - target: {fileID: 5545218454366095513, guid: 3a08a8ebfe6ab4642b6f075038bdc1c3, type: 3}
      propertyPath: m_text
      value: Sample Texture2D
      objectReference: {fileID: 0}
    - target: {fileID: 5545218454366095513, guid: 3a08a8ebfe6ab4642b6f075038bdc1c3, type: 3}
