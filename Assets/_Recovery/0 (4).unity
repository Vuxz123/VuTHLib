      value: Strip GPU-Event
      objectReference: {fileID: 0}
    - target: {fileID: 4331302149752468931, guid: d77ef93668a41394b94431636b883aa5, type: 3}
      propertyPath: m_CastShadows
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 5649587174976461374, guid: d77ef93668a41394b94431636b883aa5, type: 3}
      propertyPath: m_text
      value: "\nThere are several ways to spawn particles, and when dealing with
        <b>strips</b>, this can have some implications for how you need to set up
        your VFX. Using GPU trigger events is often the most straightforward way
        of creating <b>strips</b>. This example shows an example of a growing mushroom's
        VFX, with the mushroom\u2019s hat being particle meshes and the mushroom\u2019s
        foot made with particle <b>strips</b>.\n\n<b>Covered Aspects</b>:\n\u2022
        Strip Output Context\n\u2022 Strip Index\n\u2022 Trigger Event Rate\n\u2022
        GPU Events"
      objectReference: {fileID: 0}
    - target: {fileID: 5762328778465116255, guid: d77ef93668a41394b94431636b883aa5, type: 3}
      propertyPath: m_text
      value: Strip GPU-Event
      objectReference: {fileID: 0}
    - target: {fileID: 5762328778465116255, guid: d77ef93668a41394b94431636b883aa5, type: 3}
      propertyPath: m_fontSize
      value: 1.65
